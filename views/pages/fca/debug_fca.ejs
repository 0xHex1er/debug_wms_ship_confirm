<!DOCTYPE html>
<html lang="th">
<head>
    <%- include('../../partials/script') %>
    <style>
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased font-sans">
    <%- include('../../partials/header') %>

    <div id="vue-app" class="w-full px-4 sm:px-6 lg:px-8 py-5 pb-28" v-cloak>
        
        <!-- Header Section -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6 pb-4 border-b border-slate-200">
            <div>
                <div class="flex items-center gap-3">
                    <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center text-white text-xl shadow-md">
                        ⚡
                    </span>
                    <div>
                        <h1 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
                            FCA (Flex) Shipment Flow Debugger
                            <span class="text-xs bg-emerald-100 text-emerald-800 font-semibold px-2.5 py-0.5 rounded-full border border-emerald-300">
                                Vue2-flow
                            </span>
                        </h1>
                        <p class="text-slate-550 text-xs mt-0.5">
                            เครื่องมือตรวจสอบ Data Flow และความถูกต้องของการส่งข้อมูล Flex Shipment (Z0005/S0005) ไปยัง WDC SFTP
                        </p>
                    </div>
                </div>
            </div>

            <!-- Action Navigation Links -->
            <div class="flex items-center flex-wrap gap-2 text-xs">
                <!-- Global Connection Mode Switcher -->
                <div class="flex items-center gap-1 bg-white p-1 rounded-xl border border-slate-300 shadow-sm">
                    <span class="px-2 text-slate-500 text-[11px] font-bold hidden sm:inline">DB Mode:</span>
                    <button 
                        @click="setGlobalEnv('production')" 
                        :class="['px-3 py-1.5 rounded-lg transition text-xs font-bold flex items-center gap-1.5', globalEnv === 'production' ? 'bg-emerald-600 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900']"
                        title="สลับทุก Step เป็น Production Database"
                    >
                        <span class="w-2 h-2 rounded-full bg-emerald-300"></span> Production
                    </button>
                    <button 
                        @click="setGlobalEnv('development')" 
                        :class="['px-3 py-1.5 rounded-lg transition text-xs font-bold flex items-center gap-1.5', globalEnv === 'development' ? 'bg-amber-500 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900']"
                        title="สลับทุก Step เป็น Development Database"
                    >
                        <span class="w-2 h-2 rounded-full bg-amber-200"></span> Development
                    </button>
                </div>

                <button 
                    @click="showAllTroubleshootingModal = true" 
                    title="เปิดดูคู่มือสรุปจุดเสี่ยงและวิธีแก้ข้อมูลให้ผ่านครบทั้ง 10 Steps"
                    class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold px-3 py-2 rounded-lg border border-indigo-200 shadow-xs transition flex items-center gap-1.5 text-xs"
                >
                    <span>🛠️</span> คู่มือแก้ Error (10 Steps)
                </button>

                <a href="/debug-fca-advanced" class="bg-white hover:bg-slate-100 text-slate-700 font-medium px-3 py-2 rounded-lg border border-slate-300 shadow-sm transition flex items-center gap-1.5">
                    <span>📊</span> โหมด Batch Analysis
                </a>
                <a href="/fca-flow" class="bg-white hover:bg-slate-100 text-slate-700 font-medium px-3 py-2 rounded-lg border border-slate-300 shadow-sm transition flex items-center gap-1.5">
                    <span>📖</span> เอกสารโครงสร้าง Flow
                </a>
                <a href="/main_menu" class="bg-slate-800 hover:bg-slate-900 text-white font-medium px-3.5 py-2 rounded-lg shadow-sm transition flex items-center gap-1.5">
                    ← เมนูหลัก
                </a>
            </div>
        </div>

        <!-- Top Control Bar -->
        <div class="bg-white p-4 lg:p-5 rounded-2xl border border-slate-200 shadow-sm mb-6">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
                <!-- Date Picker -->
                <div class="md:col-span-3">
                    <label class="block text-xs font-bold text-slate-700 mb-1 flex items-center gap-1.5">
                        <span>📅</span> วันที่ยืนยันจัดส่ง (Ship Date)
                    </label>
                    <input 
                        type="date" 
                        v-model="selectedDate" 
                        class="w-full px-3 py-2 text-sm border border-slate-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition"
                    />
                </div>

                <!-- Sent Filter Checkbox -->
                <div class="md:col-span-3 flex items-center pt-2 md:pt-4">
                    <label class="flex items-center gap-2 cursor-pointer select-none text-xs text-slate-700 font-medium bg-slate-50 px-3 py-2.5 rounded-xl border border-slate-200 hover:bg-slate-100 w-full transition">
                        <input 
                            type="checkbox" 
                            v-model="excludeSentDOs" 
                            class="w-4 h-4 text-emerald-600 rounded focus:ring-emerald-500 border-slate-300"
                        />
                        <span>กรอง DO ที่ส่งแล้วออก (Exclude Sent)</span>
                    </label>
                </div>

                <!-- Fetch DOs Button -->
                <div class="md:col-span-2 pt-2 md:pt-4">
                    <button 
                        @click="fetchDOs" 
                        :disabled="loadingDos" 
                        class="w-full bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-xl text-sm font-semibold transition shadow-sm disabled:opacity-50 flex items-center justify-center gap-2"
                    >
                        <span v-if="!loadingDos">🔍 ค้นหา DO</span>
                        <span v-else class="flex items-center gap-1.5">
                            <span class="animate-spin w-4 h-4 border-2 border-white border-t-transparent rounded-full"></span>
                            กำลังโหลด...
                        </span>
                    </button>
                </div>

                <!-- Run Diagnose Button -->
                <div class="md:col-span-4 pt-2 md:pt-4 flex gap-2">
                    <button 
                        @click="runDiagnose" 
                        :disabled="!selectedDO || isDiagnosing" 
                        class="flex-1 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white px-4 py-2.5 rounded-xl text-sm font-semibold transition shadow-md disabled:opacity-40 flex items-center justify-center gap-2"
                    >
                        <span v-if="!isDiagnosing">⚡ วิเคราะห์ Flow (DO นี้)</span>
                        <span v-else class="flex items-center gap-2">
                            <span class="animate-spin w-4 h-4 border-2 border-white border-t-transparent rounded-full"></span>
                            กำลังวิเคราะห์แต่ละ Step...
                        </span>
                    </button>

                    <button 
                        @click="toggleStepThrough" 
                        :disabled="!selectedDO || (isDiagnosing && !isSteppingThrough)" 
                        :title="isSteppingThrough ? 'คลิกเพื่อหยุดการจำลอง' : 'จำลองการรันทีละ Step พร้อม Animation'" 
                        :class="[
                            'px-3.5 py-2.5 rounded-xl text-xs font-bold transition shrink-0 flex items-center gap-1.5 shadow-sm border select-none',
                            isSteppingThrough 
                                ? 'bg-rose-50 hover:bg-rose-100 text-rose-700 border-rose-300 animate-pulse' 
                                : 'bg-slate-100 hover:bg-slate-200 text-slate-700 border-slate-300'
                        ]"
                    >
                        <span>{{ isSteppingThrough ? '⏹️ หยุด' : '▶ ทีละก้าว' }}</span>
                    </button>
                </div>
            </div>

            <!-- DO Chips List -->
            <div class="mt-4 pt-4 border-t border-slate-100">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-2">
                    <span class="text-xs font-bold text-slate-600 flex items-center gap-1.5">
                        <span>📋</span> รายการ DO ที่พบในระบบ ({{ doList.length }} รายการ):
                    </span>
                    <div class="flex items-center gap-2 flex-wrap">
                        <span v-if="selectedDO" class="text-xs text-emerald-600 font-semibold">
                            เลือก: <span class="font-mono bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">{{ selectedDO.do }}</span>
                            ({{ selectedDO.ship_to_location || 'Hub' }})
                        </span>
                        
                        <!-- Clone to Development Button (ONLY AVAILABLE WHEN IN PRODUCTION) -->
                        <button 
                            v-if="selectedDO && globalEnv === 'production'"
                            @click="openCloneModal"
                            :disabled="isCloning"
                            title="แสดงผังจำลองและคัดลอกข้อมูล DO นี้จาก Production ไปยัง Development (BITINTRADEV)"
                            class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white px-3 py-1.5 rounded-xl text-xs font-bold transition shadow-xs disabled:opacity-50 flex items-center gap-1.5 cursor-pointer select-none"
                        >
                            <span>📦</span>
                            <span>Clone Data to Development</span>
                        </button>
                    </div>
                </div>

                <div v-if="loadingDos" class="py-4 text-center text-xs text-slate-400">
                    กำลังดึงข้อมูล DO จากฐานข้อมูล...
                </div>
                <div v-else-if="doList.length === 0" class="py-3 text-center text-xs text-slate-400 bg-slate-50 rounded-xl border border-dashed border-slate-200">
                    ไม่พบ DO ในวันที่เลือก กรุณากดค้นหาหรือเลือกวันที่อื่น
                </div>
                <div v-else class="flex flex-wrap gap-2 max-h-24 overflow-y-auto custom-scrollbar p-1">
                    <button
                        v-for="item in doList"
                        :key="item.do"
                        @click="selectDO(item)"
                        :class="[
                            'px-3 py-1.5 rounded-xl text-xs font-mono font-medium transition flex items-center gap-2 border',
                            selectedDO && selectedDO.do === item.do
                                ? 'bg-emerald-600 text-white border-emerald-600 shadow-sm'
                                : 'bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100'
                        ]"
                    >
                        <span>{{ item.do }}</span>
                        <span 
                            :class="[
                                'text-[10px] px-1.5 py-0.2 rounded font-sans',
                                selectedDO && selectedDO.do === item.do
                                    ? 'bg-emerald-700 text-white'
                                    : (item.is_sent ? 'bg-slate-200 text-slate-600' : 'bg-emerald-100 text-emerald-800')
                            ]"
                        >
                            {{ item.is_sent ? 'ส่งแล้ว' : item.ship_to_location }}
                        </span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Main Flow Viewport Section (Vue2-flow Canvas + Inspector) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-6">
            
            <!-- Left 8 Cols: Vue2-flow Interactive Canvas -->
            <div class="lg:col-span-8 flex flex-col">
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 flex-grow flex flex-col">
                    <div class="flex items-center justify-between mb-3 pb-2 border-b border-slate-150">
                        <div class="flex items-center gap-2">
                            <h2 class="text-sm font-bold text-slate-800 flex items-center gap-1.5">
                                <span>🗺️</span> FCA Interactive Execution Flow
                            </h2>
                            <span class="text-[11px] text-slate-500 hidden sm:inline">(คลิกที่โหนดเพื่อดู RAW SQL & ข้อมูลตาราง)</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <button @click="resetFlowPositions" title="จัดตำแหน่งเริ่มต้น" class="text-xs text-slate-500 hover:text-slate-800 font-medium px-2 py-1 bg-slate-100 rounded-lg hover:bg-slate-200 transition">
                                ↺ จัดผังใหม่
                            </button>
                        </div>
                    </div>

                    <!-- The Vue2-flow Component Canvas -->
                    <div class="relative w-full h-[580px] flex-grow rounded-xl overflow-hidden">
                        <v-flow 
                            ref="vflow"
                            :nodes="flowNodes" 
                            :conns="flowConns"
                            :selected-node-id="selectedNodeId"
                            :grid="true"
                            :zoomable="true"
                            :pannable="true"
                            :draggable="true"
                            @node-click="onNodeClick"
                            @pane-click="onPaneClick"
                        >
                            <!-- Custom Node Slot Template -->
                            <template slot="node" slot-scope="{ node, selected }">
                                <div 
                                    :class="[
                                        'rounded-xl border p-3 bg-white shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between cursor-pointer select-none',
                                        getNodeBorderClass(node, selected)
                                    ]"
                                    :style="{ width: (node.width || 250) + 'px', minHeight: (node.height || 105) + 'px' }"
                                >
                                    <!-- Node Header -->
                                    <div class="flex items-start justify-between gap-1.5 mb-1.5">
                                        <div class="flex items-center gap-2 min-w-0 flex-1">
                                            <div 
                                                class="w-7 h-7 rounded-lg flex items-center justify-center text-sm font-bold shrink-0 shadow-xs"
                                                :style="{ backgroundColor: node.iconBg || '#f1f5f9', color: node.iconColor || '#334155' }"
                                            >
                                                {{ node.icon || '📌' }}
                                            </div>
                                            <div class="min-w-0 flex-1">
                                                <div class="flex items-center gap-1.5 flex-wrap">
                                                    <span class="text-xs font-bold text-slate-800 leading-tight">
                                                        {{ node.name }}
                                                    </span>
                                                    <span 
                                                        v-if="node.isCustom" 
                                                        title="ขั้นตอนนี้ถูกเพิ่มเติมนอกเหนือจาก Flow ปกติของ Source Code"
                                                        class="text-[8px] font-extrabold px-1.5 py-0.2 rounded-full bg-purple-100 text-purple-700 border border-purple-300 shadow-2xs font-mono tracking-tight shrink-0 flex items-center gap-0.5"
                                                    >
                                                        <span>✨</span>CUSTOM
                                                    </span>
                                                </div>
                                                <div class="text-[10px] text-slate-400 truncate mt-0.5 font-mono">
                                                    {{ node.tableName }}
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Top Right: Connection Toggle Button & Status Badge -->
                                        <div class="flex items-center gap-1 shrink-0">
                                            <!-- Per-block Connection Switcher -->
                                            <button 
                                                @click.stop="toggleNodeEnv(node)" 
                                                :title="'สลับ Connection: ' + (node.env === 'development' ? 'Development (คลิกเพื่อเปลี่ยนเป็น Prod)' : 'Production (คลิกเพื่อเปลี่ยนเป็น Dev)')"
                                                :class="[
                                                    'text-[8.5px] font-bold px-1.5 py-0.5 rounded border transition flex items-center gap-1 shrink-0',
                                                    node.env === 'development' ? 'bg-amber-50 text-amber-700 border-amber-300 hover:bg-amber-100' : 'bg-emerald-50 text-emerald-700 border-emerald-300 hover:bg-emerald-100'
                                                ]"
                                            >
                                                <span :class="['w-1.5 h-1.5 rounded-full', node.env === 'development' ? 'bg-amber-500' : 'bg-emerald-500']"></span>
                                                <span>{{ node.env === 'development' ? 'DEV' : 'PROD' }}</span>
                                            </button>

                                            <!-- Status Badge -->
                                            <span 
                                                :class="[
                                                    'text-[9px] font-semibold px-2 py-0.5 rounded-full border shrink-0 flex items-center gap-1',
                                                    getStatusBadge(node.status).class
                                                ]"
                                            >
                                                <span>{{ getStatusBadge(node.status).icon }}</span>
                                                <span>{{ getStatusBadge(node.status).text }}</span>
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Node Footer / Data Summary & Quick Run -->
                                    <div class="text-[10px] text-slate-600 bg-slate-50 rounded-lg px-2 py-1 border border-slate-100 flex items-center justify-between mt-auto font-mono">
                                        <span class="text-slate-500 truncate max-w-[120px]">{{ node.dataSummary || (node.dataCount !== undefined ? node.dataCount + ' รายการ' : 'คลิกดูข้อมูล') }}</span>
                                        <div class="flex items-center gap-1">
                                            <span v-if="node.timeMs" class="text-slate-400 text-[9px]">{{ node.timeMs }}ms</span>
                                            <button 
                                                @click.stop="runSingleStep(node)" 
                                                :disabled="!selectedDO || runningStepNum === node.stepNum"
                                                title="รันเฉพาะ Step นี้"
                                                class="text-indigo-600 hover:text-indigo-800 hover:bg-indigo-100/60 px-1.5 py-0.5 rounded transition font-bold text-[9px] flex items-center gap-0.5 border border-indigo-200 bg-white shadow-2xs"
                                            >
                                                <span v-if="runningStepNum === node.stepNum" class="animate-spin w-2 h-2 border border-indigo-600 border-t-transparent rounded-full"></span>
                                                <span v-else>▶</span>
                                                <span>รัน</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </template>
                        </v-flow>
                    </div>
                </div>
            </div>

            <!-- Right 4 Cols: Step Inspector Drawer Panel -->
            <div class="lg:col-span-4 flex flex-col">
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 lg:p-5 flex-grow flex flex-col max-h-[650px] overflow-y-auto custom-scrollbar">
                    
                    <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-150">
                        <h2 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                            <span>🔍</span> Step Inspector (รายละเอียด)
                        </h2>
                        <span v-if="activeStep" class="text-xs font-mono bg-slate-100 text-slate-600 px-2 py-0.5 rounded">
                            Step {{ activeStep.stepNum }}
                        </span>
                    </div>

                    <!-- When a step is selected -->
                    <div v-if="activeStep" class="space-y-4 text-xs">
                        
                        <!-- Step Title & Status -->
                        <div>
                            <div class="flex items-center justify-between mb-1 gap-2">
                                <div class="flex items-center gap-2 flex-wrap min-w-0">
                                    <span class="font-bold text-slate-800 text-sm">{{ activeStep.name }}</span>
                                    <span 
                                        v-if="activeStep.isCustom" 
                                        class="text-[9px] font-bold px-2 py-0.5 rounded-md bg-purple-100 text-purple-700 border border-purple-300 flex items-center gap-1 shadow-2xs"
                                    >
                                        <span>✨</span> CUSTOM (เพิ่มเติมนอกเหนือจาก Flow ปกติ)
                                    </span>
                                </div>
                                <span 
                                    :class="[
                                        'text-[10px] font-semibold px-2 py-0.5 rounded-full border shrink-0',
                                        getStatusBadge(activeStep.status).class
                                    ]"
                                >
                                    {{ getStatusBadge(activeStep.status).icon }} {{ getStatusBadge(activeStep.status).text }}
                                </span>
                            </div>
                            <p class="text-slate-500 text-[11px] leading-relaxed">{{ activeStep.description }}</p>
                        </div>

                        <!-- Manual Step Test Action Bar -->
                        <div class="bg-indigo-50/70 p-3 rounded-xl border border-indigo-200/80 flex items-center justify-between gap-2 shadow-2xs">
                            <div>
                                <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-700 block">Manual Step Test</span>
                                <span class="font-semibold text-slate-800 text-xs">ทดสอบรันเฉพาะ Step {{ activeStep.stepNum }}</span>
                            </div>
                            <button 
                                @click="runSingleStep(activeStep)" 
                                :disabled="!selectedDO || runningStepNum === activeStep.stepNum" 
                                class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold px-3 py-1.5 rounded-lg shadow-xs transition flex items-center gap-1.5 disabled:opacity-50"
                            >
                                <span v-if="runningStepNum === activeStep.stepNum" class="animate-spin w-3 h-3 border-2 border-white border-t-transparent rounded-full"></span>
                                <span v-else>▶</span>
                                <span>{{ runningStepNum === activeStep.stepNum ? 'กำลังรัน...' : 'รันเฉพาะขั้นนี้' }}</span>
                            </button>
                        </div>

                        <!-- Connection Switcher Box in Inspector -->
                        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 flex items-center justify-between">
                            <div>
                                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 block">Database Connection</span>
                                <span class="font-bold text-slate-800 text-xs font-mono">
                                    {{ activeStep.env === 'development' ? 'Development (BITINTRADEV)' : ((activeStep.stepNum === 5 || activeStep.stepNum === 6) ? 'Production (SGFCDB02)' : 'Production (BITINTRA)') }}
                                </span>
                            </div>
                            <div class="flex items-center gap-1 bg-white p-0.5 rounded-lg border border-slate-200 shadow-2xs">
                                <button 
                                    @click="setStepEnv(activeStep, 'production')"
                                    :class="['px-2.5 py-1 rounded text-[10px] font-bold transition flex items-center gap-1', (activeStep.env || 'production') === 'production' ? 'bg-emerald-600 text-white' : 'text-slate-500 hover:text-slate-800']"
                                >
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Prod
                                </button>
                                <button 
                                    @click="setStepEnv(activeStep, 'development')"
                                    :class="['px-2.5 py-1 rounded text-[10px] font-bold transition flex items-center gap-1', activeStep.env === 'development' ? 'bg-amber-500 text-white' : 'text-slate-500 hover:text-slate-800']"
                                >
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-300"></span> Dev
                                </button>
                            </div>
                        </div>

                        <div class="flex items-center gap-2 text-[11px] text-slate-500 font-mono">
                            <span class="bg-slate-100 px-2 py-0.5 rounded">DB: {{ activeStep.database }}</span>
                            <span v-if="activeStep.timeMs" class="bg-slate-100 px-2 py-0.5 rounded">Time: {{ activeStep.timeMs }}ms</span>
                        </div>

                        <!-- Status Alert Box -->
                        <div 
                            v-if="activeStep.message"
                            :class="[
                                'p-3 rounded-xl border text-xs leading-relaxed',
                                activeStep.status === 'success' ? 'bg-emerald-50 text-emerald-800 border-emerald-200' :
                                activeStep.status === 'error' ? 'bg-rose-50 text-rose-800 border-rose-200 font-medium' :
                                activeStep.status === 'warning' ? 'bg-amber-50 text-amber-800 border-amber-200' :
                                'bg-slate-50 text-slate-700 border-slate-200'
                            ]"
                        >
                            {{ activeStep.message }}
                        </div>

                        <!-- RAW SQL Section -->
                        <div v-if="activeStep.sql" class="mt-3">
                            <div class="flex items-center justify-between mb-1.5">
