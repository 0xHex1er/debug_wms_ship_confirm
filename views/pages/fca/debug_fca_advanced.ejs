<!DOCTYPE html>
<html lang="th">
<head>
    <%- include('../../partials/script') %>
</head>
<body class="bg-slate-50 text-slate-800 antialiased font-sans">
    <%- include('../../partials/header') %>

    <div id="vue-app" class="w-full px-4 sm:px-6 lg:px-8 py-5 pb-28" v-cloak>
        
        <!-- Header -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6 pb-4 border-b border-slate-200">
            <div>
                <div class="flex items-center gap-3">
                    <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center text-white text-xl shadow-md">
                        📊
                    </span>
                    <div>
                        <h1 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
                            FCA Batch Diagnostics & Audit Summary
                            <span class="text-xs bg-cyan-100 text-cyan-800 font-semibold px-2.5 py-0.5 rounded-full border border-cyan-300">
                                Batch Mode
                            </span>
                        </h1>
                        <p class="text-slate-550 text-xs mt-0.5">
                            วิเคราะห์และตรวจสอบความถูกต้องของทุกลำดับ DO ประจำวันพร้อมกันแบบรวดเร็ว
                        </p>
                    </div>
                </div>
            </div>

            <!-- Navigation Links & Connection Selector -->
            <div class="flex items-center flex-wrap gap-2 text-xs">
                <!-- Global Connection Mode Switcher -->
                <div class="flex items-center gap-1 bg-white p-1 rounded-xl border border-slate-300 shadow-sm">
                    <span class="px-2 text-slate-500 text-[11px] font-bold hidden sm:inline">DB Mode:</span>
                    <button 
                        @click="setEnv('production')" 
                        :class="['px-3 py-1.5 rounded-lg transition text-xs font-bold flex items-center gap-1.5', currentEnv === 'production' ? 'bg-emerald-600 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900']"
                    >
                        <span class="w-2 h-2 rounded-full bg-emerald-300"></span> Production
                    </button>
                    <button 
                        @click="setEnv('development')" 
                        :class="['px-3 py-1.5 rounded-lg transition text-xs font-bold flex items-center gap-1.5', currentEnv === 'development' ? 'bg-amber-500 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900']"
                    >
                        <span class="w-2 h-2 rounded-full bg-amber-200"></span> Development
                    </button>
                </div>

                <a href="/debug-fca" class="bg-emerald-600 hover:bg-emerald-700 text-white font-medium px-3.5 py-2 rounded-lg shadow-sm transition flex items-center gap-1.5">
                    <span>⚡</span> ไปที่ Vue2-flow Debugger
                </a>
                <a href="/main_menu" class="bg-slate-800 hover:bg-slate-900 text-white font-medium px-3.5 py-2 rounded-lg shadow-sm transition flex items-center gap-1.5">
                    ← เมนูหลัก
                </a>
            </div>
        </div>

        <!-- Filter & Action Card -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm mb-6">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
                <div class="md:col-span-4">
                    <label class="block text-xs font-bold text-slate-700 mb-1">
                        📅 เลือกวันที่ต้องการวิเคราะห์แบบกลุ่ม (Batch Date)
                    </label>
                    <input 
                        type="date" 
                        v-model="selectedDate" 
                        class="w-full px-3 py-2 text-sm border border-slate-300 rounded-xl focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 outline-none transition"
                    />
                </div>

                <div class="md:col-span-4 flex items-center pt-2 md:pt-4">
                    <label class="flex items-center gap-2 cursor-pointer select-none text-xs text-slate-700 font-medium bg-slate-50 px-3 py-2.5 rounded-xl border border-slate-200 hover:bg-slate-100 w-full transition">
                        <input 
                            type="checkbox" 
                            v-model="excludeSentDOs" 
                            class="w-4 h-4 text-cyan-600 rounded focus:ring-cyan-500 border-slate-300"
                        />
                        <span>กรอง DO ที่ส่งแล้วออก (Exclude Sent)</span>
                    </label>
                </div>

                <div class="md:col-span-4 pt-2 md:pt-4">
                    <button 
                        @click="runBatchDiagnose" 
                        :disabled="loading" 
                        class="w-full bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-700 hover:to-blue-700 text-white px-4 py-2.5 rounded-xl text-sm font-semibold transition shadow-md disabled:opacity-50 flex items-center justify-center gap-2"
                    >
                        <span v-if="!loading">🚀 เริ่มวิเคราะห์ทุก DO ในวันนี้</span>
                        <span v-else class="flex items-center gap-2">
                            <span class="animate-spin w-4 h-4 border-2 border-white border-t-transparent rounded-full"></span>
                            กำลังประมวลผล Batch...
                        </span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Summary Metric Cards -->
        <div v-if="batchData" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            
            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block">DOs ทั้งหมด</span>
                    <span class="text-2xl font-extrabold text-slate-800 font-mono mt-1 block">
                        {{ batchData.totalDos }}
                    </span>
                    <span class="text-[10px] text-slate-400">รายการในวันที่เลือก</span>
                </div>
                <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center text-lg">
                    📋
                </div>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <span class="text-[11px] font-bold text-emerald-600 uppercase tracking-wider block">ผ่านการตรวจ (Pass)</span>
                    <span class="text-2xl font-extrabold text-emerald-600 font-mono mt-1 block">
                        {{ batchData.passCount }}
                    </span>
                    <span class="text-[10px] text-slate-400">พร้อมจัดส่ง</span>
                </div>
                <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg">
                    ✓
                </div>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <span class="text-[11px] font-bold text-rose-600 uppercase tracking-wider block">พบปัญหา (Fail)</span>
                    <span class="text-2xl font-extrabold text-rose-600 font-mono mt-1 block">
                        {{ batchData.failCount }}
                    </span>
                    <span class="text-[10px] text-slate-400">ต้องตรวจสอบแก้ไข</span>
                </div>
                <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-lg">
                    ✕
                </div>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <span class="text-[11px] font-bold text-cyan-600 uppercase tracking-wider block">อัตราความสำเร็จ</span>
                    <span class="text-2xl font-extrabold text-cyan-700 font-mono mt-1 block">
                        {{ batchData.totalDos > 0 ? Math.round((batchData.passCount / batchData.totalDos) * 100) : 0 }}%
                    </span>
                    <span class="text-[10px] text-slate-400">Success Rate</span>
                </div>
                <div class="w-10 h-10 rounded-xl bg-cyan-50 text-cyan-600 flex items-center justify-center text-lg">
                    📈
                </div>
            </div>

        </div>

        <!-- Error Breakdown Bar (If any fails) -->
        <div v-if="batchData && batchData.failCount > 0" class="bg-rose-50 border border-rose-200 rounded-2xl p-4 mb-6">
            <h3 class="text-xs font-bold text-rose-900 mb-2 flex items-center gap-1.5">
                <span>⚠️</span> สรุปจำแนกสาเหตุข้อผิดพลาดที่พบ:
            </h3>
            <div class="flex flex-wrap gap-2">
                <span 
                    v-for="(cnt, reason) in batchData.errorBreakdown" 
                    :key="reason"
                    v-if="cnt > 0"
                    class="bg-white px-3 py-1 rounded-xl text-xs font-semibold text-rose-800 border border-rose-300 shadow-xs flex items-center gap-1.5"
                >
                    <span>{{ reason }}:</span>
                    <span class="bg-rose-600 text-white text-[10px] px-1.5 py-0.2 rounded-full font-mono">{{ cnt }}</span>
                </span>
            </div>
        </div>

        <!-- DO Results Table -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-4 mb-4 border-b border-slate-150">
                <h2 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                    <span>📋</span> ผลการตรวจสอบราย DO
                </h2>

                <!-- Status Filter Tabs -->
                <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl text-xs font-medium">
                    <button 
                        @click="filterStatus = 'ALL'" 
                        :class="['px-3 py-1 rounded-lg transition', filterStatus === 'ALL' ? 'bg-white text-slate-800 shadow-xs font-bold' : 'text-slate-500 hover:text-slate-800']"
                    >
                        ทั้งหมด ({{ batchData ? batchData.results.length : 0 }})
                    </button>
                    <button 
                        @click="filterStatus = 'PASS'" 
                        :class="['px-3 py-1 rounded-lg transition', filterStatus === 'PASS' ? 'bg-white text-emerald-700 shadow-xs font-bold' : 'text-slate-500 hover:text-slate-800']"
                    >
                        ผ่าน ({{ batchData ? batchData.passCount : 0 }})
                    </button>
                    <button 
                        @click="filterStatus = 'FAIL'" 
                        :class="['px-3 py-1 rounded-lg transition', filterStatus === 'FAIL' ? 'bg-white text-rose-700 shadow-xs font-bold' : 'text-slate-500 hover:text-slate-800']"
                    >
                        ผิดพลาด ({{ batchData ? batchData.failCount : 0 }})
                    </button>
                </div>
            </div>

            <!-- Table -->
            <div v-if="loading" class="py-16 text-center text-slate-400 text-xs">
                <span class="animate-spin w-8 h-8 border-4 border-cyan-500 border-t-transparent rounded-full inline-block mb-3"></span>
                <p>กำลังวิเคราะห์และเชื่อมโยงข้อมูลฐานข้อมูล...</p>
            </div>
            <div v-else-if="!batchData || filteredResults.length === 0" class="py-12 text-center text-slate-400 text-xs">
                <span class="text-3xl block mb-2">📭</span>
                ไม่พบข้อมูลรายการ กรุณากดปุ่ม "เริ่มวิเคราะห์ทุก DO ในวันนี้" ด้านบน
            </div>
            <div v-else class="overflow-x-auto border border-slate-200 rounded-xl">
                <table class="w-full text-left border-collapse text-xs">
                    <thead class="bg-slate-100 text-slate-700 text-[11px] font-semibold border-b border-slate-200">
                        <tr>
                            <th class="px-4 py-3">#</th>
                            <th class="px-4 py-3">DO Number</th>
                            <th class="px-4 py-3">Prefix</th>
                            <th class="px-4 py-3">Ship To Location</th>
                            <th class="px-4 py-3">Plan QTY</th>
                            <th class="px-4 py-3">สถานะ (Status)</th>
                            <th class="px-4 py-3">รายละเอียด / สาเหตุ</th>
                            <th class="px-4 py-3 text-right">ดำเนินการ</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 font-mono text-[11.5px]">
                        <tr v-for="(row, idx) in filteredResults" :key="row.do" class="hover:bg-slate-50 transition">
                            <td class="px-4 py-2.5 text-slate-400">{{ idx + 1 }}</td>
                            <td class="px-4 py-2.5 font-bold text-slate-800">{{ row.do }}</td>
                            <td class="px-4 py-2.5 text-slate-600">{{ row.prefix }}</td>
                            <td class="px-4 py-2.5 text-slate-600 font-sans">{{ row.ship_to_location }}</td>
                            <td class="px-4 py-2.5 font-semibold text-slate-700">{{ formatNumber(row.planQty) }}</td>
                            <td class="px-4 py-2.5 font-sans">
                                <span 
                                    :class="[
                                        'px-2.5 py-0.5 rounded-full text-[10px] font-bold border inline-flex items-center gap-1',
                                        row.status === 'PASS' ? 'bg-emerald-100 text-emerald-800 border-emerald-300' : 'bg-rose-100 text-rose-800 border-rose-300'
                                    ]"
                                >
                                    <span>{{ row.status === 'PASS' ? '✓' : '✕' }}</span>
                                    <span>{{ row.status }}</span>
                                </span>
                            </td>
                            <td class="px-4 py-2.5 font-sans text-xs">
                                <span v-if="row.status === 'PASS'" class="text-emerald-600 font-medium">สมบูรณ์ พร้อมจัดส่ง</span>
                                <span v-else class="text-rose-600 font-semibold">{{ row.errorReason }}</span>
                            </td>
                            <td class="px-4 py-2.5 text-right font-sans">
                                <a 
                                    :href="'/debug-fca?do=' + row.do" 
                                    class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium px-2.5 py-1 rounded-lg transition"
                                >
                                    เปิด Flow →
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>

    </div>

    <script>
        new Vue({
            el: '#vue-app',
            data: {
                currentEnv: 'production',
                selectedDate: '2026-08-10',
                excludeSentDOs: true,
                loading: false,
                batchData: null,
                filterStatus: 'ALL'
            },
            computed: {
                filteredResults() {
                    if (!this.batchData || !this.batchData.results) return [];
                    if (this.filterStatus === 'ALL') return this.batchData.results;
                    return this.batchData.results.filter(r => r.status === this.filterStatus);
                }
            },
            mounted() {
                const today = new Date().toISOString().slice(0, 10);
                this.selectedDate = today;
                this.runBatchDiagnose();
            },
            methods: {
                formatNumber(val) {
                    if (val === undefined || val === null || isNaN(val)) return '0';
                    return Number(val).toLocaleString();
                },
                setEnv(env) {
                    this.currentEnv = env;
                    this.runBatchDiagnose();
                },
                async runBatchDiagnose() {
                    this.loading = true;
                    try {
                        const res = await axios.post('/api/debug/fca/diagnose-batch', {
                            date: this.selectedDate,
                            excludeSent: this.excludeSentDOs,
                            env: this.currentEnv
                        });
                        if (res.data && res.data.status === 200) {
                            this.batchData = res.data.data;
                        }
                    } catch (err) {
                        console.error('Batch diagnose error:', err);
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: err.response?.data?.error || err.message
                        });
                    } finally {
                        this.loading = false;
                    }
                }
            }
        });
    </script>
</body>
</html>
