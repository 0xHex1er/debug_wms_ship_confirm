            computed: {
                activeStep() {
                    const id = String(this.selectedNodeId || '1');
                    return this.flowNodes.find(n => n.id === id || String(n.stepNum) === id) || this.flowNodes[0];
                }
            },

            mounted() {
                // Set default date to today or 2026-08-10 for sample data
                const today = new Date().toISOString().slice(0, 10);
                this.selectedDate = today;
                this.fetchDOs();
                this.loadChatHistory();
            },

            methods: {
                formatNumber(val) {
                    if (val === undefined || val === null || isNaN(val)) return '0';
                    return Number(val).toLocaleString();
                },

                formatCellValue(val) {
                    if (val === null || val === undefined) return '';
                    if (typeof val === 'object' && val.type === 'Buffer' && Array.isArray(val.data)) {
                        try {
                            return String.fromCharCode.apply(null, val.data);
                        } catch (e) {
                            return JSON.stringify(val);
                        }
                    }
                    if (typeof val === 'object') return JSON.stringify(val);
                    return String(val);
                },

                copyText(text) {
                    if (!text) return;
                    navigator.clipboard.writeText(text).then(() => {
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'success',
                            title: 'คัดลอก SQL แล้ว',
                            showConfirmButton: false,
                            timer: 1500
                        });
                    });
                },

                getStatusBadge(status) {
                    switch (status) {
                        case 'success':
                            return { text: 'ผ่าน', class: 'bg-emerald-100 text-emerald-700 border-emerald-300', icon: '✓' };
                        case 'running':
                            return { text: 'กำลังรัน...', class: 'bg-blue-100 text-blue-700 border-blue-300 animate-pulse', icon: '⏳' };
                        case 'error':
                            return { text: 'ผิดพลาด', class: 'bg-rose-100 text-rose-700 border-rose-300', icon: '✕' };
                        case 'warning':
                            return { text: 'แจ้งเตือน', class: 'bg-amber-100 text-amber-700 border-amber-300', icon: '⚠️' };
                        default:
                            return { text: 'รอทำงาน', class: 'bg-slate-100 text-slate-500 border-slate-200', icon: '○' };
                    }
                },

                getNodeBorderClass(node, isSelected) {
                    const status = node.status || 'default';
                    let border = 'border-slate-200';
                    if (isSelected) {
                        return 'border-indigo-600 ring-4 ring-indigo-100 shadow-md';
                    }
                    switch (status) {
                        case 'success': return 'border-emerald-400 hover:border-emerald-500';
                        case 'running': return 'border-blue-500 ring-4 ring-blue-100 animate-pulse';
                        case 'error': return 'border-rose-400 hover:border-rose-500 shadow-sm';
                        case 'warning': return 'border-amber-400 hover:border-amber-500';
                        default: return 'border-slate-200 hover:border-slate-300';
                    }
                },

                onNodeClick(node) {
                    this.selectedNodeId = String(node.id || node.stepNum);
                    this.$forceUpdate();
                },

                onPaneClick() {
                    // keep current inspector active or allow deselect
                },

                closeDrawer() {
                    // close action
                },

                resetFlowPositions() {
                    const defaultPositions = [
                        { id: '1', x: 35, y: 40 },
                        { id: '2', x: 345, y: 40 },
                        { id: '3', x: 655, y: 40 },
                        { id: '4', x: 965, y: 40 },
                        { id: '5', x: 965, y: 215 },
                        { id: '6', x: 655, y: 215 },
                        { id: '7', x: 345, y: 215 },
                        { id: '8', x: 35, y: 215 },
                        { id: '9', x: 35, y: 390 },
                        { id: '10', x: 345, y: 390 }
                    ];
                    this.flowNodes.forEach(n => {
                        const def = defaultPositions.find(p => p.id === n.id);
                        if (def) {
                            n.x = def.x;
                            n.y = def.y;
                        }
                    });
                    if (this.$refs.vflow) {
                        this.$refs.vflow.resetView();
                    }
                },

                getStepDataRows(step) {
                    if (!step) return [];
                    if (step.data) {
                        if (Array.isArray(step.data)) return step.data;
                        if (typeof step.data === 'object') return [step.data];
                    }
                    if (this.diagnosticsResult) {
                        const stepKeys = ['', 'step1_trigger', 'step2_prefix', 'step3_wms', 'step4_ship_confirm', 'step5_hitachi_pack', 'step6_pack_header', 'step7_build_name', 'step8_oracle_model', 'step9_audit_csv', 'step10_sftp_config'];
                        const key = stepKeys[step.stepNum];
                        if (key && this.diagnosticsResult[key]) {
                            const stepRes = this.diagnosticsResult[key];
                            if (Array.isArray(stepRes.data)) return stepRes.data;
                            if (Array.isArray(stepRes)) return stepRes;
                            if (stepRes.data) return [stepRes.data];
                        }
                    }
                    return [];
                },

                // Environment Switcher Methods
                setGlobalEnv(env) {
                    this.globalEnv = env;
                    this.flowNodes.forEach(node => {
                        this.$set(node, 'env', env);
                        node.database = (env === 'development') 
                            ? 'BITINTRADEV' 
                            : ((node.stepNum === 5 || node.stepNum === 6) ? 'SGFCDB02 / HITACHI' : 'BITINTRA_REAL (WMS)');
                    });
                    this.flowNodes = [...this.flowNodes];
                    this.$forceUpdate();
                    this.fetchDOs();
                },

                toggleNodeEnv(node) {
                    const newEnv = (node.env === 'development') ? 'production' : 'development';
                    this.setStepEnv(node, newEnv);
                },

                setStepEnv(step, env) {
                    if (!step) return;
                    const targetNode = this.flowNodes.find(n => n.stepNum === step.stepNum || n.id === step.id);
                    if (!targetNode) return;
                    this.$set(targetNode, 'env', env);
                    targetNode.database = (env === 'development') 
                        ? 'BITINTRADEV' 
                        : ((targetNode.stepNum === 5 || targetNode.stepNum === 6) ? 'SGFCDB02 / HITACHI' : 'BITINTRA_REAL (WMS)');
                    this.flowNodes = [...this.flowNodes];
                    this.$forceUpdate();
                },

                getTableHeaders(rows) {
                    if (!rows || rows.length === 0) return [];
                    return Object.keys(rows[0]).slice(0, 6);
                },

                async fetchDOs() {
                    this.loadingDos = true;
                    this.doList = [];
                    this.selectedDO = null;
                    try {
                        const res = await axios.post('/api/debug/fca/dos', {
                            date: this.selectedDate,
                            excludeSent: this.excludeSentDOs,
                            env: this.globalEnv
                        });
                        if (res.data && res.data.status === 200) {
                            this.doList = res.data.data || [];
                            if (this.doList.length > 0) {
                                this.selectDO(this.doList[0]);
                            }
                        }
                    } catch (err) {
                        console.error('Error fetching DOs:', err);
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: err.response?.data?.error || err.message
                        });
                    } finally {
                        this.loadingDos = false;
                    }
                },

                selectDO(item) {
                    this.selectedDO = item;
                    this.resetNodeStatuses();
                },

                async openCloneModal() {
                    if (!this.selectedDO) {
                        Swal.fire({ icon: 'warning', title: 'กรุณาเลือก DO', text: 'กรุณาเลือก DO ที่ต้องการ Clone ก่อน' });
                        return;
                    }
                    if (this.globalEnv !== 'production') {
                        Swal.fire({ icon: 'info', title: 'แจ้งเตือน', text: 'ระบบไม่อนุญาตให้ Clone ข้อมูลจาก Development ไปยัง Production (อนุญาตเฉพาะ Production -> Development เท่านั้น)' });
                        return;
                    }

                    this.showCloneModal = true;
                    this.cloneFinished = false;
                    this.isCloning = false;

                    this.selectedCloneNode = null;
                    this.clonePreviewRows = {};

                    // Reset clone flow nodes & conns
                    this.cloneFlowNodes.forEach(node => {
                        this.$set(node, 'status', 'idle');
                        this.$set(node, 'count', 0);
                    });
                    this.cloneFlowConns.forEach(conn => {
                        this.$set(conn, 'status', 'default');
                        this.$set(conn, 'animated', false);
                    });
                    this.cloneFlowNodes = [...this.cloneFlowNodes];
                    this.$forceUpdate();

                    this.$nextTick(() => {
                        if (this.$refs.cloneVflow) {
                            this.$refs.cloneVflow.resetView();
                        }
                    });

                    await this.fetchClonePreview();
                },

                closeCloneModal() {
                    this.showCloneModal = false;
                    this.selectedCloneNode = null;
                },

                selectCloneNode(node) {
                    if (!node) return;
                    this.selectedCloneNode = node;
                    this.$forceUpdate();
                },

                getCloneNodeRows(node) {
                    if (!node || !this.clonePreviewRows) return [];
                    return this.clonePreviewRows[node.table] || [];
                },

                async fetchClonePreview() {
                    if (!this.selectedDO) return;
                    this.loadingClonePreview = true;
                    try {
                        const res = await axios.post('/api/debug/fca/clone-preview', {
                            doNumber: this.selectedDO.do
                        });

                        if (res.data && res.data.status === 200) {
                            const preview = res.data.data.preview || {};
                            this.clonePreviewRows = res.data.data.previewRows || {};
                            this.cloneTotalPreviewRows = res.data.data.totalPreviewRows || 0;

                            this.cloneFlowNodes.forEach(node => {
                                if (preview[node.table] !== undefined) {
                                    this.$set(node, 'count', preview[node.table]);
                                }
                            });

                            // If no node selected yet, select the first node
                            if (!this.selectedCloneNode && this.cloneFlowNodes.length > 0) {
                                this.selectedCloneNode = this.cloneFlowNodes[0];
                            }

                            this.cloneFlowNodes = [...this.cloneFlowNodes];
                            this.$forceUpdate();
                        }
                    } catch (err) {
                        console.error('Fetch clone preview error:', err);
                    } finally {
                        this.loadingClonePreview = false;
                    }
                },

                async executeClonePipeline() {
                    if (!this.selectedDO) return;
                    this.isCloning = true;

                    // Set nodes & connections to running
                    this.cloneFlowNodes.forEach(n => this.$set(n, 'status', 'running'));
                    this.cloneFlowConns.forEach(c => {
                        this.$set(c, 'status', 'running');
                        this.$set(c, 'animated', true);
                    });
                    this.cloneFlowNodes = [...this.cloneFlowNodes];
                    this.$forceUpdate();

                    try {
                        const res = await axios.post('/api/debug/fca/clone-to-dev', {
                            doNumber: this.selectedDO.do,
                            sourceEnv: 'production'
                        });

                        if (res.data && res.data.status === 200) {
                            const result = res.data.data;
                            const stats = result.stats || [];

                            this.cloneFlowNodes.forEach(node => {
                                const st = stats.find(s => s.table === node.table);
                                if (st) {
                                    this.$set(node, 'count', st.count);
                                    this.$set(node, 'status', 'success');
                                } else {
                                    this.$set(node, 'status', 'success');
                                }
                            });

                            this.cloneFlowConns.forEach(c => {
                                this.$set(c, 'status', 'success');
                                this.$set(c, 'animated', false);
                            });

                            this.cloneFinished = true;
                            this.cloneFlowNodes = [...this.cloneFlowNodes];
                            this.$forceUpdate();

                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'success',
                                title: `Clone สำเร็จ ${result.totalRowsCloned} แถว (${result.executionTime}ms)`,
                                showConfirmButton: false,
                                timer: 2500
                            });
                        } else {
                            throw new Error(res.data?.error || 'Clone failed');
                        }
                    } catch (err) {
                        console.error('Clone pipeline error:', err);
                        this.cloneFlowNodes.forEach(n => this.$set(n, 'status', 'error'));
                        this.cloneFlowConns.forEach(c => {
                            this.$set(c, 'status', 'error');
                            this.$set(c, 'animated', false);
                        });
                        this.cloneFlowNodes = [...this.cloneFlowNodes];
                        this.$forceUpdate();

                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาดในการ Clone ข้อมูล',
                            text: err.response?.data?.error || err.message
                        });
                    } finally {
                        this.isCloning = false;
                    }
                },

                switchToDevAfterClone() {
                    this.closeCloneModal();
                    this.setGlobalEnv('development');
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'info',
                        title: 'สลับเข้าสู่โหมด Development แล้ว',
                        showConfirmButton: false,
                        timer: 2000
                    });
                },

                resetNodeStatuses() {
                    this.flowNodes.forEach(node => {
                        this.$set(node, 'status', 'idle');
                        this.$set(node, 'timeMs', 0);
                        this.$set(node, 'dataSummary', '');
                        this.$set(node, 'dataCount', 0);
                        this.$set(node, 'message', '');
                        this.$set(node, 'sql', '');
                        this.$set(node, 'data', null);
                    });
                    this.flowConns.forEach(conn => {
                        this.$set(conn, 'status', 'default');
                        this.$set(conn, 'animated', false);
                    });
                    this.diagnosticsResult = null;
                    this.runningStepNum = null;
                    this.flowNodes = [...this.flowNodes];
                    this.$forceUpdate();
                },

                async runSingleStep(step) {
                    if (!step || !this.selectedDO) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'กรุณาเลือก DO',
                            text: 'กรุณาเลือก DO จากรายการด้านบนก่อนทดสอบรัน Step',
                            timer: 2000,
                            showConfirmButton: false
                        });
                        return;
                    }

                    const targetNode = this.flowNodes.find(n => n.stepNum === step.stepNum);
                    if (!targetNode) return;

                    this.selectedNodeId = String(targetNode.id || targetNode.stepNum);
                    this.runningStepNum = targetNode.stepNum;
                    this.$set(targetNode, 'status', 'running');
                    this.flowNodes = [...this.flowNodes];
                    this.$forceUpdate();

                    try {
                        const res = await axios.post('/api/debug/fca/diagnose-step', {
                            doNumber: this.selectedDO.do,
                            stepNum: targetNode.stepNum,
                            env: targetNode.env || this.globalEnv
                        }, { timeout: 15000 });

                        if (res.data && res.data.status === 200) {
                            const r = res.data.data;
                            this.$set(targetNode, 'status', r.status || 'success');
                            this.$set(targetNode, 'message', r.message || '');
                            this.$set(targetNode, 'sql', r.sql || '');
                            this.$set(targetNode, 'timeMs', r.executionTime || 0);
                            this.$set(targetNode, 'data', r.data || null);

                            if (Array.isArray(r.data)) {
                                this.$set(targetNode, 'dataCount', r.data.length);
                                this.$set(targetNode, 'dataSummary', r.data.length + ' รายการ');
                            } else if (r.data) {
                                this.$set(targetNode, 'dataCount', 1);
                                this.$set(targetNode, 'dataSummary', '1 รายการ');
                            }

                            if (!this.diagnosticsResult) this.diagnosticsResult = {};
                            const stepKeys = ['', 'step1_trigger', 'step2_prefix', 'step3_wms', 'step4_ship_confirm', 'step5_hitachi_pack', 'step6_pack_header', 'step7_build_name', 'step8_oracle_model', 'step9_audit_csv', 'step10_sftp_config'];
                            const key = stepKeys[targetNode.stepNum];
                            if (key) {
                                this.$set(this.diagnosticsResult, key, r);
                            }

                            this.flowNodes = [...this.flowNodes];
                            this.$forceUpdate();

                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: r.status === 'success' ? 'success' : (r.status === 'warning' ? 'warning' : 'error'),
                                title: `Step ${targetNode.stepNum} สำเร็จ (${r.executionTime}ms)`,
                                showConfirmButton: false,
                                timer: 1500
                            });
                        } else {
                            throw new Error(res.data?.error || 'Execution failed');
                        }
                    } catch (err) {
                        console.error('Error running single step:', err);
                        this.$set(targetNode, 'status', 'error');
                        this.flowNodes = [...this.flowNodes];
                        this.$forceUpdate();
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาดในการรัน Step',
                            text: err.response?.data?.error || err.message
                        });
                    } finally {
                        this.runningStepNum = null;
                        this.flowNodes = [...this.flowNodes];
                        this.$forceUpdate();
                    }
                },

                getEnvironmentsPayload() {
                    const environments = {};
                    this.flowNodes.forEach(n => {
                        environments['step' + n.stepNum] = n.env || this.globalEnv;
                    });
                    environments.default = this.globalEnv;
                    return environments;
                },

                async runDiagnose() {
                    if (!this.selectedDO) return;
                    this.isDiagnosing = true;
                    this.resetNodeStatuses();

                    try {
                        // Set all running
                        this.flowNodes.forEach(n => n.status = 'running');
                        this.flowConns.forEach(c => {
                            c.status = 'running';
                            c.animated = true;
                        });
                        this.flowNodes = [...this.flowNodes];
                        this.$forceUpdate();

                        const res = await axios.post('/api/debug/fca/diagnose', {
                            doNumber: this.selectedDO.do,
                            environments: this.getEnvironmentsPayload()
                        });

                        if (res.data && res.data.status === 200) {
                            this.diagnosticsResult = res.data.data;
                            this.applyDiagnosticResults(this.diagnosticsResult);
                        } else {
                            throw new Error(res.data?.error || 'Failed to diagnose');
                        }
                    } catch (err) {
                        console.error('Diagnose error:', err);
                        Swal.fire({
                            icon: 'error',
                            title: 'การวิเคราะห์ผิดพลาด',
                            text: err.response?.data?.error || err.message
                        });
                    } finally {
                        this.isDiagnosing = false;
                        this.flowNodes = [...this.flowNodes];
                        this.$forceUpdate();
                    }
                },

                applyDiagnosticResults(diag) {
                    const stepsData = [
                        diag.step1_trigger,
                        diag.step2_prefix,
                        diag.step3_wms,
                        diag.step4_ship_confirm,
                        diag.step5_hitachi_pack,
                        diag.step6_pack_header,
                        diag.step7_build_name,
                        diag.step8_oracle_model,
                        diag.step9_audit_csv,
                        diag.step10_sftp_config
                    ];

                    this.flowNodes.forEach((node, idx) => {
                        const stepData = stepsData[idx];
                        if (stepData) {
                            this.$set(node, 'status', stepData.status || 'idle');
                            this.$set(node, 'message', stepData.message || '');
                            this.$set(node, 'sql', stepData.sql || '');
                            this.$set(node, 'timeMs', stepData.executionTime || 0);
                            this.$set(node, 'data', stepData.data || null);
                            if (stepData.env) {
                                this.$set(node, 'env', stepData.env);
                            }
                            
                            if (Array.isArray(stepData.data)) {
                                this.$set(node, 'dataCount', stepData.data.length);
                                this.$set(node, 'dataSummary', stepData.data.length + ' รายการ');
                            } else if (stepData.data) {
                                this.$set(node, 'dataCount', 1);
                                this.$set(node, 'dataSummary', '1 รายการ');
                            }
                        }
                    });

                    // Update connections
                    this.flowConns.forEach((conn, idx) => {
                        const prevNode = this.flowNodes[idx];
                        this.$set(conn, 'status', prevNode ? prevNode.status : 'default');
                        this.$set(conn, 'animated', false);
                    });

                    this.flowNodes = [...this.flowNodes];
                    this.$forceUpdate();
                },

                async toggleStepThrough() {
                    if (this.isSteppingThrough) {
                        this.stepThroughCancel = true;
                        this.isSteppingThrough = false;
                        return;
                    }
                    await this.autoStepThrough();
                },

                async autoStepThrough() {
                    if (!this.selectedDO) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'กรุณาเลือก DO',
                            text: 'กรุณาเลือกรายการ DO ด้านบนก่อนเริ่มจำลองทีละก้าว',
                            timer: 2000,
                            showConfirmButton: false
                        });
                        return;
                    }
                    if (this.isDiagnosing || this.isSteppingThrough) return;

                    this.isSteppingThrough = true;
                    this.stepThroughCancel = false;

                    // Reset nodes to idle
                    this.flowNodes.forEach(n => {
                        this.$set(n, 'status', 'idle');
                        this.$set(n, 'timeMs', 0);
                        this.$set(n, 'dataSummary', '');
                    });
                    this.flowConns.forEach(c => {
                        this.$set(c, 'status', 'default');
                        this.$set(c, 'animated', false);
                    });

                    try {
                        let diag = this.diagnosticsResult;
                        // Fetch fresh diagnosis if not yet loaded
                        if (!diag) {
                            this.isDiagnosing = true;
                            const res = await axios.post('/api/debug/fca/diagnose', {
                                doNumber: this.selectedDO.do,
                                environments: this.getEnvironmentsPayload()
                            });
                            this.isDiagnosing = false;

                            if (res.data && res.data.status === 200) {
                                diag = res.data.data;
                                this.diagnosticsResult = diag;
                            } else {
                                throw new Error(res.data?.error || 'Failed to fetch diagnostic data');
                            }
                        }

                        const stepsData = [
                            diag.step1_trigger,
                            diag.step2_prefix,
                            diag.step3_wms,
                            diag.step4_ship_confirm,
                            diag.step5_hitachi_pack,
                            diag.step6_pack_header,
                            diag.step7_build_name,
                            diag.step8_oracle_model,
                            diag.step9_audit_csv,
                            diag.step10_sftp_config
                        ];

                        for (let i = 0; i < this.flowNodes.length; i++) {
                            if (this.stepThroughCancel) break;

                            const node = this.flowNodes[i];
                            const stepData = stepsData[i];
                            
                            // 1. Set node as running
                            this.$set(node, 'status', 'running');
                            this.selectedNodeId = String(node.id || node.stepNum);

                            if (i > 0) {
                                this.$set(this.flowConns[i - 1], 'status', 'running');
                                this.$set(this.flowConns[i - 1], 'animated', true);
                            }

                            // Wait 500ms for smooth animation
                            for (let t = 0; t < 5; t++) {
                                if (this.stepThroughCancel) break;
                                await new Promise(r => setTimeout(r, 100));
                            }
                            if (this.stepThroughCancel) break;

                            // 2. Set node result
                            if (stepData) {
                                this.$set(node, 'status', stepData.status || 'success');
                                this.$set(node, 'message', stepData.message || '');
                                this.$set(node, 'sql', stepData.sql || '');
                                this.$set(node, 'timeMs', stepData.executionTime || 0);
                                if (stepData.env) {
                                    this.$set(node, 'env', stepData.env);
                                }
                                if (Array.isArray(stepData.data)) {
                                    this.$set(node, 'dataCount', stepData.data.length);
                                    this.$set(node, 'dataSummary', stepData.data.length + ' รายการ');
                                } else if (stepData.data) {
                                    this.$set(node, 'dataCount', 1);
                                    this.$set(node, 'dataSummary', '1 รายการ');
                                }
                            }

                            // 3. Update previous connector
                            if (i > 0) {
                                this.$set(this.flowConns[i - 1], 'status', node.status);
                                this.$set(this.flowConns[i - 1], 'animated', false);
                            }

                            // Short pause before proceeding to next node
                            await new Promise(r => setTimeout(r, 200));
                        }

                        if (!this.stepThroughCancel) {
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'success',
                                title: 'จำลอง Flow ครบทั้ง 10 ขั้นตอนแล้ว',
                                showConfirmButton: false,
                                timer: 2000
                            });
                        }
                    } catch (err) {
                        console.error('Step through error:', err);
                        Swal.fire({
                            icon: 'error',
                            title: 'การจำลองทีละก้าวผิดพลาด',
                            text: err.response?.data?.error || err.message
                        });
                    } finally {
                        this.isDiagnosing = false;
                        this.isSteppingThrough = false;
                        this.stepThroughCancel = false;
                    }
                },

                downloadSimulatedCSV() {
                    if (!this.diagnosticsResult || !this.diagnosticsResult.step9_audit_csv.data) return;
                    const rows = this.diagnosticsResult.step9_audit_csv.data;
                    if (rows.length === 0) return;

                    const headers = [
                        'SupplierName', 'PartName', 'SHIPDATE', 'INVNUM', 'Transfer Order',
                        'PARTNUMBER', 'Pallet Number', 'MODEL', 'Plt', 'QTY', 'SUBINVENTORY',
                        'Build Name', 'ETA', 'Time', 'shipper', 'Truck or Air', 'Ship to',
                        'DN#', 'Remark', 'BOXID', 'BOXQTY', 'PACKID', 'PACKQTY', 'TRAYID', 'SERIAL'
                    ];

                    let csvContent = headers.join(',') + '\n';
                    rows.forEach(r => {
                        const line = [
                            `"${r.SupplierName || ''}"`,
                            `"${r.PartName || ''}"`,
                            `"${r.SHIPDATE || ''}"`,
                            `"${r.INVNUM || ''}"`,
                            `"${r.TransferOrder || ''}"`,
                            `"${r.PARTNUMBER || ''}"`,
                            `"${r.PalletNumber || ''}"`,
                            `"${r.MODEL || ''}"`,
                            `"${r.Plt || '1'}"`,
                            `"${r.QTY || ''}"`,
                            `"${r.SUBINVENTORY || ''}"`,
                            `"${r.BuildName || ''}"`,
                            `""`, `""`, `""`,
                            `"${r.TruckOrAir || 'Truck'}"`,
                            `"${r.ShipTo || ''}"`,
                            `""`, `""`,
                            `"${r.BOXID || ''}"`,
                            `"${r.BOXQTY || ''}"`,
                            `"${r.PACKID || ''}"`,
                            `"${r.PACKQTY || ''}"`,
                            `""`, `""`
                        ];
                        csvContent += line.join(',') + '\n';
                    });

                    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
                    const link = document.createElement('a');
                    const filename = this.diagnosticsResult.audit.targetFilename || 'FCA_TEST_EXPORT.csv';
                    link.href = URL.createObjectURL(blob);
                    link.setAttribute('download', filename);
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                },

                getStepTroubleshooting(stepNum) {
                    if (!stepNum) return null;
                    return this.troubleshootingGuide[Number(stepNum)] || null;
                },

                getDynamicStepAnalysis(step) {
                    if (!step || !step.stepNum) {
                        return {
                            table: '-',
                            db: '-',
                            risk: '-',
                            detectedCause: 'ไม่พบข้อมูลข้อผิดพลาดในขั้นตอนนี้',
                            fixSteps: [],
                            owner: '-',
                            suggestedSql: ''
                        };
                    }

                    const stepNum = Number(step.stepNum);
                    const base = this.troubleshootingGuide[stepNum] || {
                        title: `Step ${stepNum}`,
                        db: step.database || 'BITINTRA_REAL (WMS)',
                        table: step.name || '-',
                        risk: 'ระบบหยุดทำงานหรือข้ามขั้นตอนการส่งมอบนี้ไป',
                        causes: ['ข้อมูลไม่ตรงตามเงื่อนไขทางธุรกิจ'],
                        fixSteps: ['ตรวจสอบข้อมูลในฐานข้อมูลที่เกี่ยวข้อง'],
                        owner: 'ทีมงานผู้ดูแลระบบ'
                    };

                    const doNo = this.selectedDO ? this.selectedDO.do : 'DO_NUMBER';
                    const prefix = doNo ? doNo.substring(0, 4) : '';
                    const diag = this.diagnosticsResult || {};
                    const audit = diag.audit || {};
                    const msg = step.message || '';
                    const data = step.data;

                    if (step.status === 'idle') {
                        return {
                            stepNum,
                            title: base.title,
                            db: base.db,
                            table: base.table,
                            risk: 'ยังไม่ได้ทำการรันวิเคราะห์ข้อมูลของขั้นตอนนี้',
                            detectedCause: 'ขั้นตอนนี้ยังไม่ได้กดทดสอบเพื่อดึงข้อมูลจริงจาก Database (สถานะ: Idle / รอการทดสอบ)',
                            fixSteps: [
                                'กดปุ่ม "⚡ วิเคราะห์ Flow (DO นี้)" ด้านบน หรือกด "รันเฉพาะขั้นตอนนี้" เพื่อดึงข้อมูลจริงมาวิเคราะห์'
                            ],
                            owner: base.owner,
                            suggestedSql: base.suggestedSql || `SELECT * FROM ${base.table} WHERE do = '${doNo}';`
                        };
                    }

                    let detectedCause = msg || (base.causes && base.causes[0]) || 'ตรวจพบความผิดปกติในขั้นตอนนี้';
                    let fixSteps = [...(base.fixSteps || [])];
                    let suggestedSql = '';

                    switch (stepNum) {
                        case 1:
                            if (audit.isSentBefore) {
                                detectedCause = `ตรวจพบว่า DO '${doNo}' เคยส่งไฟล์ SFTP สำเร็จไปแล้วเมื่อ ${audit.sentDate ? this.formatDateTime(audit.sentDate) : 'รอบก่อนหน้า'} (มีประวัติบันทึกในตาราง WMS.HIT_TRANSFER_DATA_LOG_FTP) สคริปต์จึงกรอง DO นี้ออกอัตโนมัติเพื่อป้องกันการส่งไฟล์ซ้ำ`;
                                fixSteps = [
                                    `ตรวจสอบว่ารายการนี้ต้องการส่งซ้ำจริงหรือไม่ หากส่งสำเร็จแล้วถือว่าสมบูรณ์ ไม่จำเป็นต้องส่งซ้ำ`,
                                    `หากต้องการทดสอบรันใหม่อีกครั้ง ให้ลบประวัติ DO ออกจากตาราง WMS.HIT_TRANSFER_DATA_LOG_FTP ชั่วคราว`,
                                    `ตรวจสอบว่าวันที่ Ship Date ในระบบตรงกับรอบการประมวลผลหรือไม่`
                                ];
                                suggestedSql = `DELETE FROM WMS.HIT_TRANSFER_DATA_LOG_FTP WHERE do_no = '${doNo}';`;
                            } else if (!data || (Array.isArray(data) && data.length === 0)) {
                                detectedCause = `ไม่พบรายการ DO '${doNo}' ที่มีสถานะ 'type = PACK' ในตาราง WMS.HIT_SHIP_CONFIRM หรือยังไม่ได้รับการยืนยันในตาราง WMS.lrv_wms_check_confirm_log`;
                                fixSteps = [
                                    `ตรวจสอบกับทีมคลังสินค้า (WMS) ว่าได้ทำการยิงยืนยันการแพ็คสินค้าเสร็จสมบูรณ์หรือยัง (ฟิลด์ type ต้องเป็น 'PACK')`,
                                    `ตรวจสอบว่ามีการบันทึกยืนยันในตาราง lrv_wms_check_confirm_log สำหรับ plan_id ของ DO นี้แล้วหรือยัง`,
                                    `ตรวจสอบว่าวันที่ (date) ในตารางตรงกับวันที่ที่เลือกค้นหาหรือไม่`
                                ];
                                suggestedSql = `SELECT * FROM WMS.HIT_SHIP_CONFIRM WHERE do = '${doNo}';`;
                            }
                            break;

                        case 2:
                            if (data && data.type === 'PRB') {
                                detectedCause = `Prefix '${prefix}' ถูกระบุเป็นประเภท PRB ซึ่งในระบบ FCA ฟังก์ชันการส่ง SFTP ไปยัง PRB ถูกระงับการทำงานไว้ในสคริปต์ (ระบบจะส่งเฉพาะปลายทาง BPI Direct)`;
                                fixSteps = [
                                    `ตรวจสอบกับทีมงานว่า DO นี้เป็นของปลายทาง PRB จริงหรือไม่ หากใช่ ระบบจะข้ามการส่ง SFTP ตาม Business Rule ของ FCA`,
                                    `หากต้องการให้ส่งข้อมูล กรุณาตรวจสอบ Master ใน WMS.HIT_SHIP_TO_MASTER ว่าต้องเปลี่ยนประเภทเป็น BPI หรือไม่`
                                ];
                                suggestedSql = `SELECT * FROM WMS.HIT_SHIP_TO_MASTER WHERE prefix = '${prefix}';`;
                            } else if (!data || data.status === 'missing' || (Array.isArray(data) && data.length === 0)) {
                                detectedCause = `ไม่พบการตั้งค่า Prefix 4 ตัวแรก '${prefix}' ในตาราง WMS.HIT_SHIP_TO_MASTER หรือสถานะฟิลด์ status ไม่เป็น 'active'`;
                                fixSteps = [
                                    `เพิ่มข้อมูล Prefix '${prefix}' ในตาราง WMS.HIT_SHIP_TO_MASTER และระบุ ship_to / type ให้ถูกต้อง`,
                                    `กำหนดฟิลด์ status = 'active'`
                                ];
                                suggestedSql = `INSERT INTO WMS.HIT_SHIP_TO_MASTER (prefix, ship_to, type, status) VALUES ('${prefix}', 'BPI', 'BPI', 'active');`;
                            }
                            break;

                        case 3:
                            if (!data || (Array.isArray(data) && data.length === 0)) {
                                detectedCause = `ไม่พบข้อมูลการจับคู่ DO '${doNo}' กับ Plan ID ใน WMS.SHIPMENTDO_DATA หรือไม่มีรายการกล่องใน WMS.SHIPMENTPALLET_BOX_PROD_HTC`;
                                fixSteps = [
                                    `ตรวจสอบในระบบ WMS ว่า DO '${doNo}' ได้ถูกผูก Plan ID และสร้างรายการ Pallet/Box ในระบบเรียบร้อยหรือยัง`,
                                    `ตรวจสอบตาราง WMS.SHIPMENTPALLET_BOX_PROD_HTC ว่ามีรายการ prod_lot และ store_lot ครบถ้วนหรือไม่`
                                ];
                                suggestedSql = `SELECT * FROM WMS.SHIPMENTDO_DATA WHERE do_no = '${doNo}';`;
                            }
                            break;

                        case 4:
                            if (!data || (Array.isArray(data) && data.length === 0)) {
                                detectedCause = `ไม่พบหมายเลขพาเลท (running_pallet) ที่มีสถานะ 'Active' หรือข้อมูล box_ship_name/ship_date เป็นค่าว่างในตาราง WMS.HIT_PALLET_DATA`;
                                fixSteps = [
                                    `ตรวจสอบข้อมูลในตาราง WMS.HIT_PALLET_DATA ว่ามีรายการพาเลทตรงกับ prod_lot ของ DO '${doNo}' หรือไม่`,
                                    `ตรวจสอบว่าฟิลด์ status ในตาราง HIT_PALLET_DATA เป็น 'Active' (ตัวพิมพ์ใหญ่)`
                                ];
                                suggestedSql = `SELECT * FROM WMS.HIT_PALLET_DATA WHERE prod_lot IN (SELECT prod_lot FROM WMS.SHIPMENTPALLET_BOX_PROD_HTC WHERE plan_id IN (SELECT plan_id FROM WMS.SHIPMENTDO_DATA WHERE do_no = '${doNo}'));`;
                            }
                            break;

                        case 5:
                            if (!data || (Array.isArray(data) && data.length === 0)) {
                                detectedCause = `ไม่พบรายการ Lot การผลิตในฐานข้อมูลฝ่ายผลิต HITACHI.PROD_DATA (บน Server SGFCDB02) ตรงกับ prod_lot ใน WMS`;
                                fixSteps = [
                                    `ตรวจสอบว่าฝ่ายผลิต Hitachi ได้ทำการบันทึกข้อมูลและ Sync เข้าระบบ SGFCDB02 เรียบร้อยแล้วหรือยัง`,
                                    `ตรวจสอบการสะกดของ prod_lot ใน WMS ว่าตรงกับหมายเลขในตาราง HITACHI.PROD_DATA หรือไม่`
                                ];
                                suggestedSql = `SELECT * FROM HITACHI.PROD_DATA WHERE prod_lot IN (SELECT prod_lot FROM WMS.SHIPMENTPALLET_BOX_PROD_HTC WHERE plan_id IN (SELECT plan_id FROM WMS.SHIPMENTDO_DATA WHERE do_no = '${doNo}'));`;
                            }
                            break;

                        case 6:
                            if (!data || (Array.isArray(data) && data.length === 0)) {
                                detectedCause = `ไม่พบข้อมูล Pack ID ในตาราง HITACHI.PACK_HEADER (บน Server SGFCDB02) สำหรับ prod_lot ดังกล่าว`;
                                fixSteps = [
                                    `ตรวจสอบกับหัวหน้างานแพ็ค Hitachi ว่าขั้นตอนการยิง Pack ID เสร็จสมบูรณ์แล้วหรือไม่`,
                                    `ตรวจสอบว่า pack_id และ prod_lot มีการเชื่อมโยงถูกต้องในระบบ SGFCDB02`
                                ];
                                suggestedSql = `SELECT * FROM HITACHI.PACK_HEADER WHERE prod_lot = '...';`;
                            }
                            break;

                        case 7:
                            detectedCause = msg || `ไม่พบข้อมูล Build Name / Remark ในตาราง WMS.HIT_FGREC_DATA สำหรับ DO '${doNo}'`;
                            fixSteps = [
                                `ตรวจสอบตาราง WMS.HIT_FGREC_DATA ว่ามีบันทึกค่า remark สำหรับ customer_pn ของ DO นี้หรือไม่`,
                                `หากไม่มี ให้ประสานงานทีม WMS หรือ Master Data ทำการเพิ่มข้อมูล remark ให้ตรงตามสเปก`
                            ];
                            suggestedSql = `SELECT customer_pn, remark FROM WMS.HIT_FGREC_DATA WHERE customer_pn = '...';`;
                            break;

                        case 8:
                            detectedCause = msg || `ไม่สามารถค้นหา Model Name ในระบบ Oracle หรือ WMS Master สำหรับ Part Number นี้ได้`;
                            fixSteps = [
                                `ตรวจสอบในระบบ Master Oracle ว่า Part Number นี้มี Model Name ผูกไว้หรือไม่`,
                                `ตรวจสอบการตั้งค่า Mapping Customer PN ในระบบ WMS`
                            ];
                            break;

                        case 9:
                            if (audit && audit.totalConfirmQty !== audit.totalHitachiQty) {
                                const diff = Math.abs((audit.totalConfirmQty || 0) - (audit.totalHitachiQty || 0));
                                detectedCause = `ตรวจพบยอดจำนวนชิ้นงานไม่ตรงกัน: ยอด WMS Plan QTY = ${this.formatNumber(audit.totalConfirmQty)} ชิ้น แต่ยอด Hitachi Scanned Pack QTY = ${this.formatNumber(audit.totalHitachiQty)} ชิ้น (ผลต่างต่างกัน ${this.formatNumber(diff)} ชิ้น)`;
                                fixSteps = [
                                    `ตรวจสอบว่า WMS มีการคีย์จำนวนเกิน หรือทางฝ่ายผลิต Hitachi สแกน Pack ID ไม่ครบตามยอด`,
                                    `ทำการตรวจสอบและปรับยอดจำนวนชิ้นงานระหว่าง 2 ระบบให้ตรงกันก่อนทำการส่งไฟล์ CSV SFTP`
                                ];
                            } else {
                                detectedCause = msg || `ไม่สามารถสร้างและตรวจสอบความถูกต้องของไฟล์ CSV 25 คอลัมน์ได้`;
                            }
                            break;

                        case 10:
                            detectedCause = msg || `ไม่พบข้อมูลการตั้งค่า SFTP ในตาราง WMS.HIT_FTP_CONFIG หรือไม่สามารถเชื่อมต่อไปยังเซิร์ฟเวอร์ SFTP ลูกค้าได้`;
                            fixSteps = [
                                `ตรวจสอบการตั้งค่าในตาราง WMS.HIT_FTP_CONFIG ว่ามี host, user, remote_path ถูกต้อง`,
                                `ตรวจสอบไฟล์ SSH Private Key (Belton.ppk) ว่ามีอยู่จริงและสิทธิ์ถูกต้อง`,
                                `ตรวจสอบการเปิด Port Firewall ภายในองค์กรไปยัง sftp2.wdc.com`
                            ];
                            suggestedSql = `SELECT * FROM WMS.HIT_FTP_CONFIG WHERE type = 'FCA';`;
                            break;
                    }

                    return {
                        table: base.table,
                        db: base.db,
                        risk: base.risk,
                        detectedCause: detectedCause,
                        fixSteps: fixSteps,
                        owner: base.owner,
                        suggestedSql: suggestedSql
                    };
                },

                selectStepFromModal(stepNum) {
                    this.showAllTroubleshootingModal = false;
                    const targetNode = this.flowNodes.find(n => n.stepNum === Number(stepNum));
                    if (targetNode) {
                        this.selectedNodeId = String(targetNode.id || targetNode.stepNum);
                    }
                },

                saveOpenClawConfig() {
                    localStorage.setItem('openclaw_auth_cookie', this.openClawCookie || '');
                    localStorage.setItem('openclaw_base_url', this.openClawUrl || 'https://openclaw-th.beltontechnology.com');
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: 'บันทึกการตั้งค่า Open Claw แล้ว',
                        showConfirmButton: false,
                        timer: 1500
                    });
                },

                async testOpenClawConnection() {
                    if (!this.openClawCookie) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'กรุณาระบุ Cookie',
                            text: 'กรุณากรอกหรือวางค่า Cookie _openclaw_auth ก่อนทำการทดสอบ',
                            timer: 2500,
                            showConfirmButton: false
                        });
                        return;
                    }

                    this.openClawTesting = true;
                    this.openClawTestResult = null;
                    try {
                        const res = await axios.post('/api/openclaw/test-connection', {
                            cookie: this.openClawCookie,
                            endpointUrl: this.openClawUrl
                        });
                        this.openClawTestResult = {
                            success: true,
                            message: `เชื่อมต่อสำเร็จ (${res.data.durationMs}ms)`,
                            data: res.data
                        };
                        this.saveOpenClawConfig();
                    } catch (err) {
                        console.error('Test Open Claw error:', err);
                        this.openClawTestResult = {
                            success: false,
                            message: err.response?.data?.error || err.message,
                            details: err.response?.data?.details
                        };
                    } finally {
                        this.openClawTesting = false;
                    }
                },

                async diagnoseWithOpenClaw(step) {
                    if (!step) return;

                    this.loadingOpenClaw = true;
                    this.openClawTargetStep = step.stepNum;

                    try {
                        const doNo = this.selectedDO ? this.selectedDO.do : '';
                        const dynamicAnalysis = this.getDynamicStepAnalysis(step);

                        const res = await axios.post('/api/openclaw/diagnose', {
                            stepNum: step.stepNum,
                            stepName: step.name,
                            doNumber: doNo,
                            sql: step.sql,
                            data: step.data,
                            message: step.message,
                            table: dynamicAnalysis.table || step.tableName,
                            db: dynamicAnalysis.db || step.database,
                            detectedCause: dynamicAnalysis.detectedCause,
                            env: step.env || this.globalEnv,
                            cookie: this.openClawCookie,
                            endpointUrl: this.openClawUrl
                        });

                        if (res.data && res.data.status === 200) {
                            const resultData = res.data.data;
                            this.$set(this.openClawResults, step.stepNum, resultData);
                            this.$forceUpdate();

                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'success',
                                title: `Belton AI วิเคราะห์ Step ${step.stepNum} เสร็จสิ้น (${resultData.durationMs}ms)`,
                                showConfirmButton: false,
                                timer: 2000
                            });
                        } else {
                            throw new Error(res.data?.error || 'Failed to diagnose');
                        }
                    } catch (err) {
                        console.error('Diagnose with Open Claw error:', err);
                        const errorMsg = err.response?.data?.error || err.message;
                        const hint = err.response?.data?.hint || '';
                        Swal.fire({
                            icon: 'error',
                            title: 'Open Claw AI เกิดข้อผิดพลาด',
                            html: `<div class="text-left text-xs space-y-2 font-sans">
                                    <p class="font-bold text-rose-600">${errorMsg}</p>
                                    ${hint ? `<p class="bg-amber-50 p-2 rounded text-amber-800 border border-amber-200">💡 <b>คำแนะนำ:</b> ${hint}</p>` : ''}
                                   </div>`,
                            showCancelButton: true,
                            cancelButtonText: 'ปิด',
                            confirmButtonText: 'ตั้งค่า Cookie ใหม่'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                this.showOpenClawConfigModal = true;
                            }
                        });
                    } finally {
                        this.loadingOpenClaw = false;
                        this.openClawTargetStep = null;
                    }
                },

                clearAIResult(stepNum) {
                    this.$delete(this.openClawResults, stepNum);
                    this.$forceUpdate();
                },

                formatMarkdown(text) {
                    if (!text) return '';
                    let html = text
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;');

                    html = html.replace(/```([a-z]*)\n([\s\S]*?)```/gm, '<pre class="bg-slate-900 text-emerald-300 p-3.5 rounded-xl font-mono text-[11.5px] my-2.5 overflow-x-auto whitespace-pre-wrap border border-slate-800 select-all shadow-xs">$2</pre>');
                    html = html.replace(/`([^`]+)`/g, '<code class="bg-rose-50 text-rose-700 px-1.5 py-0.5 rounded font-mono text-[11px] border border-rose-200 font-semibold">$1</code>');
                    html = html.replace(/\*\*([^*]+)\*\*/g, '<strong class="text-slate-900 font-bold">$1</strong>');
                    html = html.replace(/^### (.*$)/gim, '<h4 class="font-bold text-rose-700 text-xs mt-3 mb-1 flex items-center gap-1">$1</h4>');
                    html = html.replace(/^## (.*$)/gim, '<h3 class="font-extrabold text-slate-900 text-sm mt-3.5 mb-1.5 border-b border-slate-200 pb-1">$1</h3>');
                    html = html.replace(/^# (.*$)/gim, '<h2 class="font-extrabold text-slate-900 text-base mt-4 mb-2">$1</h2>');
                    html = html.replace(/\n/g, '<br>');

                    return html;
                },

                // =========================================================
                // AI Interactive Chat Methods (with Image Attachment Support)
                // =========================================================
                compressImageFile(file, callback) {
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        const img = new Image();
                        img.onload = () => {
                            let width = img.width;
                            let height = img.height;
                            const maxDim = 1280;
                            if (width > maxDim || height > maxDim) {
                                if (width > height) {
                                    height = Math.round((height * maxDim) / width);
                                    width = maxDim;
                                } else {
                                    width = Math.round((width * maxDim) / height);
                                    height = maxDim;
                                }
                            }
                            const canvas = document.createElement('canvas');
                            canvas.width = width;
                            canvas.height = height;
                            const ctx = canvas.getContext('2d');
                            ctx.drawImage(img, 0, 0, width, height);
                            const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
                            const approxKb = (dataUrl.length * 0.75 / 1024).toFixed(1) + ' KB';
                            callback(dataUrl, approxKb);
                        };
                        img.src = e.target.result;
                    };
                    reader.readAsDataURL(file);
                },

                async runOcrOnImage(imgObj) {
                    if (typeof Tesseract === 'undefined' || !Tesseract.recognize) {
                        this.$set(imgObj, 'ocrStatus', 'skipped');
                        return;
                    }
                    try {
                        this.$set(imgObj, 'ocrStatus', 'processing');
                        const result = await Tesseract.recognize(
                            imgObj.dataUrl,
                            'eng+tha',
                            {
                                logger: m => {
                                    if (m.status === 'recognizing text' && m.progress) {
                                        this.$set(imgObj, 'ocrProgress', Math.round(m.progress * 100));
                                    }
                                }
                            }
                        );
                        const extractedText = (result && result.data && result.data.text) ? result.data.text.trim() : '';
                        this.$set(imgObj, 'ocrText', extractedText);
                        this.$set(imgObj, 'ocrStatus', extractedText ? 'done' : 'empty');
                    } catch (err) {
                        console.warn('[OCR] Recognition notice:', err.message);
                        this.$set(imgObj, 'ocrStatus', 'failed');
                    } finally {
                        this.$forceUpdate();
                    }
                },

                handleChatPaste(e) {
                    const clipboardData = e.clipboardData || window.clipboardData;
                    if (!clipboardData || !clipboardData.items) return;
                    
                    const items = clipboardData.items;
                    let imageHandled = false;
                    for (let i = 0; i < items.length; i++) {
                        const item = items[i];
                        if (item.type && item.type.indexOf('image') !== -1) {
                            const file = item.getAsFile();
                            if (file && !imageHandled) {
                                imageHandled = true;
                                if (e.preventDefault) e.preventDefault();
                                if (e.stopPropagation) e.stopPropagation();

                                this.compressImageFile(file, (dataUrl, sizeStr) => {
                                    const exists = this.chatAttachedImages.some(img => img.dataUrl === dataUrl);
                                    if (!exists) {
                                        const imgObj = {
                                            id: Date.now() + Math.random(),
                                            dataUrl: dataUrl,
                                            name: file.name || `screenshot_${Date.now()}.jpg`,
                                            size: sizeStr,
                                            ocrText: '',
                                            ocrStatus: 'processing'
                                        };
                                        this.chatAttachedImages.push(imgObj);
                                        this.runOcrOnImage(imgObj);
                                    }
                                });
                                break;
                            }
                        }
                    }
                },

                handleFileSelect(e) {
                    const files = e.target.files;
                    if (!files || files.length === 0) return;
                    Array.from(files).forEach(file => {
                        if (file.type && file.type.startsWith('image/')) {
                            this.compressImageFile(file, (dataUrl, sizeStr) => {
                                const exists = this.chatAttachedImages.some(img => img.dataUrl === dataUrl);
                                if (!exists) {
                                    const imgObj = {
                                        id: Date.now() + Math.random(),
                                        dataUrl: dataUrl,
                                        name: file.name || `image_${Date.now()}.jpg`,
                                        size: sizeStr,
                                        ocrText: '',
                                        ocrStatus: 'processing'
                                    };
                                    this.chatAttachedImages.push(imgObj);
                                    this.runOcrOnImage(imgObj);
                                }
                            });
                        }
                    });
                    if (this.$refs.chatImageInput) this.$refs.chatImageInput.value = '';
                },

                removeAttachedImage(index) {
                    this.chatAttachedImages.splice(index, 1);
                },

                async sendChatMessage() {
                    const text = (this.chatInputText || '').trim();
                    const attachedImgs = [...this.chatAttachedImages.map(img => img.dataUrl)];
                    if ((!text && attachedImgs.length === 0) || this.isChatSending) return;

                    if (!this.openClawCookie) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'กรุณาระบุ Cookie',
                            text: 'กรุณากรอกหรือวางค่า Cookie _openclaw_auth ก่อนเริ่มใช้งาน AI Chat',
                            confirmButtonText: 'ตั้งค่า Cookie ตอนนี้',
                            showCancelButton: true,
                            cancelButtonText: 'ยกเลิก'
                        }).then((res) => {
                            if (res.isConfirmed) {
                                this.showOpenClawConfigModal = true;
                            }
                        });
                        return;
                    }

                    // Extract OCR text from attached images if available
                    const attachedOcrTexts = this.chatAttachedImages
                        .map((img, i) => img.ocrText ? `[ข้อความที่ตรวจพบจากรูปภาพที่ ${i+1} (${img.name}) ด้วย OCR]:\n${img.ocrText}` : '')
                        .filter(Boolean);

                    let userMsgContent = text || 'ช่วยตรวจสอบและวิเคราะห์รูปภาพนี้';
                    if (attachedOcrTexts.length > 0) {
                        userMsgContent += '\n\n' + attachedOcrTexts.join('\n\n');
                    }

                    // Add user message to history with images
                    this.chatMessages.push({
                        role: 'user',
                        content: userMsgContent,
                        images: attachedImgs,
                        timestamp: new Date().toISOString()
                    });
                    this.chatInputText = '';
                    this.chatAttachedImages = [];
                    this.isChatSending = true;
                    this.isAIChatCollapsed = false;
                    this.scrollChatToBottom();

                    // Setup cancellation tokens
                    const CancelToken = (typeof axios !== 'undefined') ? axios.CancelToken : null;
                    this.chatCancelSource = CancelToken ? CancelToken.source() : null;
                    this.chatAbortController = (typeof AbortController !== 'undefined') ? new AbortController() : null;

                    try {
                        const step = this.activeStep || {};
                        const dynamicAnalysis = (step.stepNum && typeof this.getDynamicStepAnalysis === 'function') 
                            ? this.getDynamicStepAnalysis(step) 
                            : {};
                        
                        // Build all steps summary
                        const allStepsSummary = (this.flowNodes || []).map(node => {
                            return `Step ${node.stepNum} (${node.name}): Status=${node.status || 'idle'}, Desc=${node.description || '-'}`;
                        }).join('\n');

                        const axiosConfig = {};
                        if (this.chatCancelSource) axiosConfig.cancelToken = this.chatCancelSource.token;
                        if (this.chatAbortController) axiosConfig.signal = this.chatAbortController.signal;

                        const res = await axios.post('/api/openclaw/chat', {
                            messages: this.chatMessages.map(m => ({ 
                                role: m.role, 
                                content: m.content,
                                images: m.images || []
                            })),
                            context: {
                                doNumber: this.selectedDO ? this.selectedDO.do : '',
                                selectedDODetails: this.selectedDO || null,
                                selectedDate: this.selectedDate || '',
                                isDiagnosed: !!this.diagnosticsResult,
                                stepNum: step.stepNum || 1,
                                stepName: step.name || '',
                                stepStatus: step.status || 'idle',
                                sql: step.sql || '',
                                data: step.data || null,
                                message: step.message || '',
                                table: dynamicAnalysis.table || step.tableName || '',
                                db: dynamicAnalysis.db || step.database || '',
                                detectedCause: dynamicAnalysis.detectedCause || '',
                                env: step.env || this.globalEnv,
                                allStepsSummary: allStepsSummary,
                                audit: (this.diagnosticsResult && this.diagnosticsResult.audit) ? this.diagnosticsResult.audit : null
                            },
                            cookie: this.openClawCookie,
                            endpointUrl: this.openClawUrl
                        }, axiosConfig);

                        if (res.data && res.data.status === 200) {
                            const replyData = res.data.data;
                            this.chatMessages.push({
                                role: 'assistant',
                                content: replyData.reply,
                                durationMs: replyData.durationMs,
                                timestamp: replyData.timestamp || new Date().toISOString()
                            });
                            this.saveChatHistory();
                        } else {
                            throw new Error(res.data?.error || 'เกิดข้อผิดพลาดในการตอบกลับจาก AI');
                        }
                    } catch (err) {
                        if (
                            (axios.isCancel && axios.isCancel(err)) ||
                            err.name === 'CanceledError' || 
                            err.name === 'AbortError' || 
                            err.message === 'User canceled request'
                        ) {
                            console.log('[OpenClaw] Request was stopped by user.');
                            return;
                        }
                        console.error('Chat error:', err);
                        const errorMsg = err.response?.data?.error || err.message;
                        const hint = err.response?.data?.hint || '';
                        this.chatMessages.push({
                            role: 'assistant',
                            content: `⚠️ **เกิดข้อผิดพลาด**: ${errorMsg}${hint ? `\n\n💡 *คำแนะนำ:* ${hint}` : ''}`,
                            timestamp: new Date().toISOString()
                        });
                    } finally {
                        this.isChatSending = false;
                        this.chatCancelSource = null;
                        this.chatAbortController = null;
                        this.scrollChatToBottom();
                    }
                },

                stopChatMessage() {
                    if (this.chatCancelSource) {
                        try { this.chatCancelSource.cancel('User canceled request'); } catch (e) {}
                        this.chatCancelSource = null;
                    }
                    if (this.chatAbortController) {
                        try { this.chatAbortController.abort(); } catch (e) {}
                        this.chatAbortController = null;
                    }
                    this.isChatSending = false;
                    this.chatMessages.push({
                        role: 'assistant',
                        content: '⏹️ *การคิดวิเคราะห์ถูกหยุดโดยผู้ใช้*',
                        timestamp: new Date().toISOString()
                    });
                    this.saveChatHistory();
                    this.scrollChatToBottom();
                },

                sendQuickPrompt(promptText) {
                    if (!promptText) return;
                    this.chatInputText = promptText;
                    this.sendChatMessage();
                },

                askAIChatAboutStep(step) {
                    if (!step) return;
                    this.selectedNodeId = String(step.id || step.stepNum);
                    this.isAIChatCollapsed = false;
                    this.$nextTick(() => {
                        const chatElem = document.getElementById('ai-chat-section');
                        if (chatElem) {
                            chatElem.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }
                    });
                    this.sendQuickPrompt(`วิเคราะห์ปัญหาและแนะนำ SQL Fix สำหรับ Step ${step.stepNum} (${step.name})`);
                },

                clearChatMessages() {
                    this.chatMessages = [];
                    sessionStorage.removeItem('openclaw_chat_history');
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: 'ล้างประวัติการสนทนาแล้ว',
                        showConfirmButton: false,
                        timer: 1500
                    });
                },

                scrollChatToBottom() {
                    this.$nextTick(() => {
                        const el = this.$refs.chatMessagesContainer;
                        if (el) {
                            el.scrollTop = el.scrollHeight;
                        }
                    });
                },

                saveChatHistory() {
                    try {
                        sessionStorage.setItem('openclaw_chat_history', JSON.stringify((this.chatMessages || []).slice(-20)));
                    } catch (e) {}
                },

                loadChatHistory() {
                    try {
                        const saved = sessionStorage.getItem('openclaw_chat_history');
                        if (saved) {
                            this.chatMessages = JSON.parse(saved);
                        }
                    } catch (e) {}
                },

                formatTime(ts) {
                    if (!ts) return '';
                    try {
                        if (typeof window !== 'undefined' && typeof window.moment === 'function') {
                            return window.moment(ts).format('HH:mm:ss');
                        }
                        const d = new Date(ts);
                        return isNaN(d.getTime()) ? String(ts) : d.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
                    } catch (e) {
                        return '';
                    }
                },

                formatDateTime(ts) {
                    if (!ts) return '';
                    try {
                        if (typeof window !== 'undefined' && typeof window.moment === 'function') {
                            return window.moment(ts).format('YYYY-MM-DD HH:mm:ss');
                        }
                        const d = new Date(ts);
                        return isNaN(d.getTime()) ? String(ts) : d.toLocaleString('th-TH');
                    } catch (e) {
                        return '';
                    }
                },

                moment(d) {
                    if (typeof window !== 'undefined' && typeof window.moment === 'function') {
                        return window.moment(d);
                    }
                    return { format: () => String(d || '') };
                }
            }
        });
    </script>
</body>
</html>
