<!DOCTYPE html>
<html lang="th">
<head>
    <%- include('../partials/script') %>
</head>

<body class="bg-slate-950 text-slate-100 antialiased font-sans min-h-screen relative selection:bg-rose-500 selection:text-white">
    <%- include('../partials/header') %>

    <!-- Ambient Glowing Light Orbs -->
    <div class="fixed top-20 left-1/4 -translate-x-1/2 w-[500px] h-[500px] bg-rose-600/10 rounded-full blur-3xl pointer-events-none z-0"></div>
    <div class="fixed bottom-10 right-1/4 translate-x-1/2 w-[500px] h-[500px] bg-indigo-600/10 rounded-full blur-3xl pointer-events-none z-0"></div>

    <div class="container mx-auto px-4 sm:px-6 py-8 pb-28 max-w-5xl relative z-10">
        
        <!-- Welcome Hero Section -->
        <div class="bg-gradient-to-br from-slate-900/90 via-slate-900/80 to-rose-950/40 backdrop-blur-xl rounded-3xl p-6 sm:p-8 shadow-2xl border border-white/10 mb-8 relative overflow-hidden group">
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-rose-500 to-transparent"></div>
            <div class="absolute right-0 top-0 translate-x-10 -translate-y-10 w-72 h-72 bg-rose-500/15 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative z-10">
                <div class="flex items-center gap-2 text-xs font-semibold text-rose-300 bg-rose-950/80 px-3 py-1 rounded-full border border-rose-800/80 w-fit mb-3.5 shadow-inner font-mono">
                    <span class="w-2 h-2 rounded-full bg-rose-400 animate-pulse"></span>
                    <span>FTP Monitoring & Diagnostic System</span>
                </div>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight bg-gradient-to-r from-white via-slate-100 to-rose-200 bg-clip-text text-transparent">
                    WD FTP TO CUSTOMER DEBUGGER
                </h1>
                <p class="text-slate-300/90 text-xs sm:text-sm mt-2 max-w-2xl leading-relaxed">
                    ศูนย์กลางการตรวจสอบ วิเคราะห์ และจำลองกระบวนการส่งออกข้อมูลการจัดส่งสินค้าไปยัง Western Digital Corporation (WDC) รองรับทั้งระบบ Carriage (ACA) และ Flex Shipment (FCA)
                </p>
            </div>
        </div>

        <!-- Section Title -->
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-lg font-bold text-white flex items-center gap-2">
                    <span>🚀</span> เลือกระบบผลิตภัณฑ์ที่ต้องการตรวจสอบ
                </h2>
                <p class="text-xs text-slate-400 mt-0.5">เลือกสายการผลิต Carriage (ACA) หรือ Flex (FCA) เพื่อเข้าสู่หน้า Diagnostic</p>
            </div>
        </div>

        <!-- Main Product Line Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <!-- 1. Card ACA (Carriage) -->
            <a 
                href="/debug-aca" 
                class="group bg-slate-900/70 backdrop-blur-xl p-6 sm:p-7 rounded-3xl border border-slate-800 shadow-xl hover:border-cyan-500/60 hover:shadow-[0_0_30px_rgba(6,182,212,0.2)] transition-all duration-300 flex flex-col justify-between relative overflow-hidden hover:-translate-y-1"
            >
                <div class="absolute top-0 left-0 h-1.5 w-full bg-gradient-to-r from-cyan-500 to-blue-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                
                <div>
                    <div class="flex items-center justify-between mb-5">
                        <div class="w-14 h-14 rounded-2xl bg-cyan-950/70 border border-cyan-800/50 text-cyan-400 flex items-center justify-center text-2xl group-hover:scale-110 group-hover:bg-cyan-600 group-hover:text-white transition-all duration-300 shadow-inner">
                            🚚
                        </div>
                        <span class="text-[11px] font-mono font-semibold bg-cyan-950/80 text-cyan-300 px-3 py-1 rounded-full border border-cyan-800/60 shadow-inner">
                            Z0004 / S0004
                        </span>
                    </div>

                    <h3 class="text-xl font-bold text-white group-hover:text-cyan-400 transition-colors flex items-center gap-2">
                        ACA Debugger
                    </h3>
                    <p class="text-xs font-semibold text-cyan-400 mt-0.5 font-mono">Carriage Shipment System</p>
                    
                    <p class="text-xs text-slate-300 mt-3.5 leading-relaxed">
                        ตรวจสอบกระบวนการส่งข้อมูล Carriage Shipment ตรวจสอบบาร์โค้ดถาดสินค้า (Tray Barcode), ปริมาณการจัดส่ง, และการคำนวณวันหมดอายุ (Expiry Date) จาก PackKey
                    </p>
                </div>

                <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs">
                    <div class="flex items-center gap-1.5 text-slate-400">
                        <span class="bg-slate-950 px-2.5 py-1 rounded-lg text-[11px] font-mono border border-slate-800 text-slate-300">HGSTACA_*</span>
                        <span class="bg-slate-950 px-2.5 py-1 rounded-lg text-[11px] border border-slate-800 text-slate-300">Belton_Carriage</span>
                    </div>
                    <span class="font-bold text-cyan-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                        เข้าสู่ระบบ →
                    </span>
                </div>
            </a>

            <!-- 2. Card FCA (Flex) with Vue2-flow -->
            <a 
                href="/debug-fca" 
                class="group bg-slate-900/70 backdrop-blur-xl p-6 sm:p-7 rounded-3xl border border-slate-800 shadow-xl hover:border-rose-500/60 hover:shadow-[0_0_30px_rgba(225,29,72,0.25)] transition-all duration-300 flex flex-col justify-between relative overflow-hidden hover:-translate-y-1"
            >
                <div class="absolute top-0 left-0 h-1.5 w-full bg-gradient-to-r from-rose-500 via-red-500 to-amber-500"></div>
                <div class="absolute top-4 right-4 bg-gradient-to-r from-rose-600 to-red-600 text-white text-[10px] font-extrabold uppercase px-3 py-1 rounded-full shadow-md tracking-wider font-mono border border-rose-400/30">
                    ✨ Vue2-flow
                </div>

                <div>
                    <div class="flex items-center justify-between mb-5">
                        <div class="w-14 h-14 rounded-2xl bg-rose-950/70 border border-rose-800/50 text-rose-400 flex items-center justify-center text-2xl group-hover:scale-110 group-hover:bg-rose-600 group-hover:text-white transition-all duration-300 shadow-inner">
                            ⚡
                        </div>
                        <span class="text-[11px] font-mono font-semibold bg-rose-950/80 text-rose-300 px-3 py-1 rounded-full border border-rose-800/60 mr-24 shadow-inner">
                            Z0005 / S0005
                        </span>
                    </div>

                    <h3 class="text-xl font-bold text-white group-hover:text-rose-400 transition-colors flex items-center gap-2">
                        FCA Debugger
                    </h3>
                    <p class="text-xs font-semibold text-rose-400 mt-0.5 font-mono">Flex Shipment Flow System</p>
                    
                    <p class="text-xs text-slate-300 mt-3.5 leading-relaxed">
                        วิเคราะห์กระบวนการ Flex Shipment บน <strong>Vue2-flow Interactive Canvas</strong> ตรวจสอบลอตผลิตฝั่ง Hitachi (PROD_DATA), หมายเหตุ Build Name, เปรียบเทียบยอด QTY และจำลองไฟล์ CSV 25 คอลัมน์
                    </p>
                </div>

                <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs">
                    <div class="flex items-center gap-1.5 text-slate-400">
                        <span class="bg-slate-950 px-2.5 py-1 rounded-lg text-[11px] font-mono border border-slate-800 text-rose-300 font-semibold">HIT_*</span>
                        <span class="bg-slate-950 px-2.5 py-1 rounded-lg text-[11px] border border-slate-800 text-slate-300">Flow Inspector</span>
                    </div>
                    <span class="font-bold text-rose-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                        เข้าสู่ระบบ →
                    </span>
                </div>
            </a>

        </div>

    </div>

    <!-- Footer -->
    <footer class="fixed bottom-0 left-0 right-0 bg-slate-950/90 backdrop-blur-md border-t border-slate-800 py-3 z-30">
        <p class="text-center text-slate-400 text-xs font-medium">
            Information Technology © 2026 | WD FTP Diagnostic Platform
        </p>
    </footer>

</body>
</html>